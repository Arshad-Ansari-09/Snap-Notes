<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="icon" type="image/x-icon" href="/favicon.png" />
    <link rel="stylesheet" href="/CSS/profile.css">
    <title>Snap Notes - Profile</title>
    <meta
      name="description"
      content="Snap Notes — Profile. Manage your account and see your stats."
    />

    <!-- Lucide icons (same as home page) -->
    <script src="https://unpkg.com/lucide@latest"></script>

  </head>

  <body>
    <!-- New navbar (home-like). Kept profile link and theme toggle.
         Your old navBar partial is intentionally not used here to match the new home style. -->
    <header class="navbar">
      <div class="navbar-inner">
        <div class="brand">
          <div class="brand-logo">S</div>
          <div>
            <div class="brand-title">Snap Notes</div>
            <div class="brand-subtitle">Smart notes library</div>
          </div>
        </div>

        <nav class="nav-links">
          <a href="/">Home</a>
          <a href="/friends">Friends</a>
          <a href="/mynotes">My Notes</a>
          <a href="/logout" ><i data-lucide="log-out"></i>  </a>
        </nav>

        <div class="nav-right">
          <div class="theme-toggle" id="themeToggle" title="Toggle theme">
            <i data-lucide="sun" style="width: 18px; height: 18px"></i>
          </div>

          <a class="avatar" href="/profile" title="Profile">
            <img src="<%= loggedInUser.profileImg %>" alt="Profile" />
          </a>
          <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open menu">
            <i data-lucide="menu" style="width:20px;height:20px"></i>
          </button>
        </div>
      </div>
          <!-- Mobile Navigation Overlay -->
<div class="mobile-nav-overlay" id="mobileNavOverlay"></div>

<!-- Mobile Navigation Panel -->
<nav class="mobile-nav hidden" id="mobileNav">
  <div class="mobile-nav-header">
    <div class="mobile-nav-title">Menu</div>
    <button class="mobile-nav-close" id="mobileNavClose" aria-label="Close menu">
      <i data-lucide="x" style="width:18px;height:18px"></i>
    </button>
  </div>
  
  <div class="mobile-nav-links">
    <a href="/">
      <i data-lucide="home" style="width:18px;height:18px"></i>
      Home
    </a>
    <a href="/friends">
      <i data-lucide="users" style="width:18px;height:18px"></i>
      Friends
    </a>
    <a href="/mynotes">
      <i data-lucide="book-open" style="width:18px;height:18px"></i>
      My Notes
    </a>
    <a href="/logout">
      <i data-lucide="log-out" style="width:18px;height:18px"></i>
      Logout
    </a>
  </div>
  
  <div class="mobile-nav-divider"></div>
  
  <div class="mobile-nav-footer">
    <a href="/profile" class="btn-ghost" style="justify-content: center;">
      <i data-lucide="user" style="width:16px;height:16px"></i>
      View Profile
    </a>
  </div>
  </nav>
    </header>

    <div class="shell">
      <section class="page-header">
        <h1 class="page-title">Your profile</h1>
        <p class="page-subtitle">View your stats and update your username.</p>
      </section>

      <section class="profile-grid">
        <!-- LEFT: main profile card -->
        <article class="card">
          <div class="card-head">
            <div class="card-title">
              <span class="icon-chip">
                <i data-lucide="user" style="width: 18px; height: 18px"></i>
              </span>
              Profile overview
            </div>

            <!-- KEEP YOUR EXISTING LOGIC: same id "EditUserInfo" -->
            <a href="" id="EditUserInfo" class="edit-btn" title="Edit profile">
              <i data-lucide="pencil" style="width: 18px; height: 18px"></i>
            </a>
          </div>

          <div class="card-body">
            <div class="profile-top">
              <div class="profile-photo">
                <img src="<%= loggedInUser.profileImg %>" alt="Profile image" />
                <!-- KEEP your existing route for changing profile image -->
                <a class="photo-edit" href="/change/profileImg" title="Change photo">
                  <i data-lucide="camera" style="width: 18px; height: 18px"></i>
                </a>
              </div>

              <div class="profile-meta">
                <h2><%= loggedInUser.username %></h2>
                <p>
                  <i data-lucide="mail" style="width: 14px; height: 14px"></i>
                  <span><%= loggedInUser.email %></span>
                </p>
              </div>
            </div>

            <div class="stats">
              <div class="stat">
                <div class="num"><%= loggedInUser.friends.length %></div>
                <div class="lbl">Friends</div>
              </div>
              <div class="stat">
                <div class="num"><%= loggedInUser.posts.length %></div>
                <div class="lbl">Posts</div>
              </div>
              <div class="stat">
                <div class="num"><%= followers.length %></div>
                <div class="lbl">Followers</div>
              </div>
            </div>

            <div class="divider"></div>

            <!-- KEEP YOUR EXISTING DOM IDs and toggle logic -->
            <div id="userInfo">
              <div style="display: grid; gap: 0.5rem">
                <div>
                  <div class="label">Username</div>
                  <div style="margin-top: 0.25rem; font-weight: 600">
                    <%= loggedInUser.username %>
                  </div>
                </div>

                <div>
                  <div class="label">Signed in as</div>
                  <div style="margin-top: 0.25rem; color: var(--text-muted)">
                    <%= loggedInUser.email %>
                  </div>
                </div>
              </div>
            </div>

            <!-- KEEP your form id and behavior (hidden toggled by the same JS) -->
            <form action="" method="post" id="userUpdateForm" class="hidden" style="margin-top: 0.3rem">
              <div class="form-row">
                <label class="label" for="usernameInput">User name</label>
                <input
                  id="usernameInput"
                  type="text"
                  required
                  name="username"
                  value="<%= loggedInUser.username %>"
                  class="input"
                />
              </div>

              <div class="form-row">
                <label class="label" for="emailInput">Email</label>
                <input
                  id="emailInput"
                  disabled
                  type="email"
                  name="inputname"
                  value="<%= loggedInUser.email %>"
                  class="input"
                  style="opacity: 0.75"
                />
                <div class="hint">Email cannot be changed here.</div>
              </div>

              <button type="submit" class="btn-save">Change</button>
            </form>

            <div class="divider"></div>
            <div class="quote">
              “If you have knowledge, let others light their candles in it.”
            </div>
          </div>
        </article>

        <!-- RIGHT: small side card (optional but matches home layout vibe) -->
        <aside class="card">
          <div class="card-head">
            <div class="card-title">
              <span class="icon-chip">
                <i data-lucide="shield-check" style="width: 18px; height: 18px"></i>
              </span>
              Account
            </div>
          </div>
          <div class="card-body" style="display: grid; gap: 0.75rem">
            <div style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.4">
              Keep your profile photo and username up to date so friends can find you easily.
            </div>

            <a class="btn" href="/mynotes">
              <i data-lucide="notebook" style="width: 14px; height: 14px"></i>
              Go to My Notes
            </a>

            <a class="btn btn-primary" href="/">
              <i data-lucide="home" style="width: 14px; height: 14px"></i>
              Explore notes
            </a>
          </div>
        </aside>
      </section>
    </div>

    <script src="/JS/profile.js"></script>
  </body>
</html>