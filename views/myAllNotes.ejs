<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="icon" type="image/x-icon" href="/favicon.png" />
    <link rel="stylesheet" href="/CSS/myAllNotes.css">
    <title>Snap Notes - My Notes</title>
    <meta
      name="description"
      content="Snap Notes — Manage and update your uploaded handwritten notes."
    />

    <!-- Lucide icons (same vibe as home) -->
    <script src="https://unpkg.com/lucide@latest"></script>

  </head>

  <body>
    <!-- Home-like navbar (instead of your partial to match redesign) -->
    <header class="navbar">
      <div class="navbar-inner">
        <div class="brand">
          <div class="brand-logo">S</div>
          <div>
            <div class="brand-title">Snap Notes</div>
            <div class="brand-subtitle">Smart notes library</div>
          </div>
        </div>

        <nav class="nav-links">
          <a href="/">Home</a>
          <a href="/friends">Friends</a>
          <a href="/mynotes" class="active">My Notes</a>
          <a href="/logout">
            <i data-lucide="log-out" style="width:18px;height:18px"></i>
          </a>
        </nav>

        <div class="nav-right">
          <div class="theme-toggle" id="themeToggle" title="Toggle theme">
            <i data-lucide="sun" style="width: 18px; height: 18px"></i>
          </div>

          <a class="avatar" href="/profile" title="Profile">
            <img src="<%= loggedInUser.profileImg %>" alt="Profile" />
          </a>
          <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open menu">
           <i data-lucide="menu" style="width:20px;height:20px"></i>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Overlay -->
<div class="mobile-nav-overlay" id="mobileNavOverlay"></div>

<!-- Mobile Navigation Panel -->
<nav class="mobile-nav hidden" id="mobileNav">
  <div class="mobile-nav-header">
    <div class="mobile-nav-title">Menu</div>
    <button class="mobile-nav-close" id="mobileNavClose" aria-label="Close menu">
      <i data-lucide="x" style="width:18px;height:18px"></i>
    </button>
  </div>
  
  <div class="mobile-nav-links">
    <a href="/">
      <i data-lucide="home" style="width:18px;height:18px"></i>
      Home
    </a>
    <a href="/friends">
      <i data-lucide="users" style="width:18px;height:18px"></i>
      Friends
    </a>
    <a href="/mynotes" class="active">
      <i data-lucide="book-open" style="width:18px;height:18px"></i>
      My Notes
    </a>
    <a href="/logout">
      <i data-lucide="log-out" style="width:18px;height:18px"></i>
      Logout
    </a>
  </div>
  
  <div class="mobile-nav-divider"></div>
  
  <div class="mobile-nav-footer">
    <a href="/profile" class="btn-ghost" style="justify-content: center;">
      <i data-lucide="user" style="width:16px;height:16px"></i>
      View Profile
    </a>
  </div>
  </nav>

    </header>

    <div class="shell">
      <section class="page-header">
        <h1 class="page-title">My notes</h1>
        <p class="page-subtitle">Preview, edit, or delete notes you uploaded.</p>
      </section>

      <% if (notes.length > 0) { %>
      <main class="grid">
        <% notes.forEach(note => { %>
        <!-- IMPORTANT: keep .main, .editBtn, .updateNotesForm, .noteDetail, .preview-img for your JS logic -->
        <article class="note-card main">
          <div class="note-thumb">
            <img
              class="preview-img"
              src="<%= note.notesImages[0] %>"
              data-images='<%= JSON.stringify(note.notesImages) %>'
              alt="Note preview"
            />
            <div class="note-thumb-gradient"></div>

            <span class="badge-top">
              <i data-lucide="book-open" style="width: 12px; height: 12px"></i>
              <%= note.classname %>
            </span>

            <div class="actions">
              <!-- Edit icon (keep class editBtn for your logic) -->
              <button class="icon-btn editBtn" type="button" title="Edit">
                <i data-lucide="pencil" style="width: 16px; height: 16px"></i>
              </button>

              <!-- Delete (keep your route) -->
              <a
                class="icon-btn"
                href="/deleteNotes/<%= note._id %>"
                title="Delete"
              >
                <i data-lucide="trash-2" style="width: 16px; height: 16px"></i>
              </a>
            </div>
          </div>

          <div class="note-body">
            <div class="noteDetail">
              <div class="meta">
                <p class="note-title"><%= note.notesInfo %></h5>

              <div class="tags">
                <span class="tag"><%= note.classname %></span>
                <span class="tag"><%= note.notesImages.length %> pages</span>
              </div>

              <div class="note-meta">
                <p class="author">
                  <i data-lucide="user" style="width:13px;height:13px"></i>
                  By <span><%= note.user.username %></span>
                </p>
              </div>
              </div>

              <div class="footer-row">
                <button
                  class="btn-danger"
                  onclick="window.location.href='/deleteNotes/<%= note._id %>'">
                  <i data-lucide="trash" style="width: 14px; height: 14px"></i>
                  Delete
                </button>

                <span style="font-size: 0.75rem; color: var(--text-muted)">
                  <%= note.notesImages.length %> pages
                </span>
              </div>
            </div>

            <!-- Keep your form action + class names for JS toggle -->
            <form
              class="updateNotesForm hidden"
              action="/updateNote/<%= note._id %>"
              method="post"
            >
              <input
                class="input"
                placeholder="Class Name"
                type="text"
                name="classname"
                value="<%= note.classname %>"
              />
              <input
                class="input"
                placeholder="Notes Info"
                type="text"
                name="notesInfo"
                value="<%= note.notesInfo %>"
              />
              <button type="submit" class="btn-update">Update</button>
            </form>
          </div>
        </article>
        <% }) %>
      </main>
      <% } else { %>
      <div class="empty">
        <h2>No notes yet</h2>
        <p>Upload to see your notes here.</p>
      </div>
      <% } %>
    </div>

    <script src="/JS/myAllNotes.js"></script>
  </body>
</html>