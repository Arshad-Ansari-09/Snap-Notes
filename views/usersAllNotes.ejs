<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <link rel="icon" type="image/x-icon" href="/favicon.png" />
    <link rel="stylesheet" href="/CSS/usersAllNotes.css">
    <title>Snap Notes — User Notes</title>
    <meta
      name="description"
      content="Snap Notes — Browse and download shared handwritten notes."
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://unpkg.com/lucide@latest"></script>

  </head>

  <body>
    <header class="navbar">
      <div class="navbar-inner">
        <div class="brand">
          <div class="brand-logo">S</div>
          <div>
            <div class="brand-title">Snap Notes</div>
            <div class="brand-subtitle">Smart notes library</div>
          </div>
        </div>

        <nav class="nav-links">
          <a href="/">Home</a>
          <a href="/friends" class="active">Friends</a>
          <a href="/mynotes">My Notes</a>
          <a href="">Services</a>
        </nav>

        <div class="nav-right">
          <div class="theme-toggle" id="themeToggle" title="Toggle theme">
            <i data-lucide="sun" style="width:18px;height:18px"></i>
          </div>

          <a class="avatar" href="/profile" title="Profile">
            <img
              src="<%= (typeof loggedInUser !== 'undefined' && loggedInUser.profileImg) ? loggedInUser.profileImg : (typeof currentUser !== 'undefined' && currentUser.profileImg) ? currentUser.profileImg : '/favicon.png' %>"
              alt="Profile"
            />
          </a>
          <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open menu">
         <i data-lucide="menu" style="width:20px;height:20px"></i>
        </button>
        </div>
      </div>
          <!-- Mobile Navigation Overlay -->
<div class="mobile-nav-overlay" id="mobileNavOverlay"></div>

<!-- Mobile Navigation Panel -->
<nav class="mobile-nav hidden" id="mobileNav">
  <div class="mobile-nav-header">
    <div class="mobile-nav-title">Menu</div>
    <button class="mobile-nav-close" id="mobileNavClose" aria-label="Close menu">
      <i data-lucide="x" style="width:18px;height:18px"></i>
    </button>
  </div>
  
  <div class="mobile-nav-links">
    <a href="/" class="active">
      <i data-lucide="home" style="width:18px;height:18px"></i>
      Home
    </a>
    <a href="/friends">
      <i data-lucide="users" style="width:18px;height:18px"></i>
      Friends
    </a>
    <a href="/mynotes">
      <i data-lucide="book-open" style="width:18px;height:18px"></i>
      My Notes
    </a>
    <a href="/logout">
      <i data-lucide="log-out" style="width:18px;height:18px"></i>
      Logout
    </a>
  </div>
  
  <div class="mobile-nav-divider"></div>
  
  <div class="mobile-nav-footer">
    <a href="/profile" class="btn-ghost" style="justify-content: center;">
      <i data-lucide="user" style="width:16px;height:16px"></i>
      View Profile
    </a>
  </div>
  </nav>
    </header>

    <main class="shell">
      <section class="page-header">
        <h1 class="page-title"><%= user.username %>'s notes</h1>
        <p class="page-subtitle">Filter and download notes shared by this user.</p>
      </section>

      <section class="toolbar">
        <div class="toolbar-left">
          <span class="label">Filter</span>

          <div class="select-wrap">
            <select id="class-filter" class="select">
              <option value="Class">Class</option>
              <option value="BCA">BCA</option>
              <option value="MCA">MCA</option>
              <option value="B.Com">B.Com</option>
              <option value="M.Com">M.Com</option>
              <option value="B.Tech">B.Tech</option>
              <option value="M.Tech">M.Tech</option>
              <option value="12th">12th</option>
              <option value="11th">11th</option>
              <option value="10th">10th</option>
              <option value="9th">9th</option>
            </select>
            <i data-lucide="chevron-down" style="width:13px;height:13px"></i>
          </div>

          <div class="select-wrap">
            <select id="sem-filter" class="select">
              <option value="Sem">Sem</option>
              <option value="1st">1st</option>
              <option value="2nd">2nd</option>
              <option value="3rd">3rd</option>
              <option value="4th">4th</option>
              <option value="5th">5th</option>
              <option value="6th">6th</option>
              <option value="7th">7th</option>
              <option value="8th">8th</option>
            </select>
            <i data-lucide="chevron-down" style="width:13px;height:13px"></i>
          </div>
        </div>

        <div class="toolbar-right">
          <div class="search">
            <input
              id="nameInput"
              type="text"
              placeholder="Search by name or notes info"
              autocomplete="off"
            />
          </div>
        </div>
      </section>

      <section id="Container" class="grid">
        <% notes.forEach(note => { %>
        <div>
          <article class="note-card">
            <div class="note-thumb">
              <img
                class="preview-img"
                src="<%= note.notesImages[0] %>"
                alt="Note preview"
                data-images='<%= JSON.stringify(note.notesImages) %>'
              />
              <div class="note-thumb-gradient"></div>

              <span class="badge-top">
                <i data-lucide="book-open" style="width:12px;height:12px"></i>
                <%= note.classname %>
              </span>

              <button
                class="download-btn download-pdf-btn"
                title="Download Options"
                data-images='<%= JSON.stringify(note.notesImages) %>'
                data-classname="<%= note.classname %>"
                data-info="<%= note.notesInfo %>"
              >
                <span class="btn-icon">
                  <i data-lucide="download" style="width:15px;height:15px"></i>
                </span>

                <span class="btn-spinner hidden">
                  <svg class="animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" width="18" height="18">
                    <circle opacity="0.25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path opacity="0.75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                  </svg>
                </span>

                <span class="btn-progress-text hidden" style="margin-left:6px;font-size:0.72rem;font-weight:600;"></span>
              </button>

              <div class="download-menu hidden">
                <button class="download-as-pdf">Download as PDF 📄</button>
                <button class="download-as-images">Download as Images 🖼️</button>
              </div>
            </div>

            <div class="note-body">
              <div class="note-title notesInfo"><%= note.notesInfo %></div>

              <div class="tags">
                <span class="tag"><%= note.classname %></span>
                <span class="tag"><%= note.notesImages.length %> pages</span>
              </div>

              <div class="note-meta">
                <div class="className hidden">Class name: <%= note.classname %></div>
                <div class="userName hidden">By: <%= user.username %></div>

                <p class="author">
                  <i data-lucide="user" style="width:13px;height:13px"></i>
                  By <span><%= user.username %></span>
                </p>
              </div>
            </div>
          </article>
        </div>
        <% }) %>
      </section>
    </main>

    <script src="/JS/usersAllNotes.js"></script>
  </body>
</html>