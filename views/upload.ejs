<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.png" />
    <link rel="stylesheet" href="/CSS/upload.css">
    <title>Snap Notes — Upload</title>
    <meta
      name="description"
      content="Snap Notes — Upload handwritten notes to share with friends."
    />

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <!-- Poppins + Lucide (home-like) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://unpkg.com/lucide@latest"></script>

  </head>

  <body>
    <!-- ✅ Home page navbar links + upload button + theme toggle + avatar -->
    <header class="navbar">
      <div class="navbar-inner">
        <div class="brand">
          <div class="brand-logo">S</div>
          <div>
            <div class="brand-title">Snap Notes</div>
            <div class="brand-subtitle">Smart notes library</div>
          </div>
        </div>

        <nav class="nav-links">
          <a href="/">Home</a>
          <a href="/friends">Friends</a>
          <a href="/mynotes">My Notes</a>
          <a href="/logout">
            <i data-lucide="log-out" style="width:18px;height:18px"></i>
          </a>
        </nav>

        <div class="nav-right">

          <div class="theme-toggle" id="themeToggle" title="Toggle theme">
            <i data-lucide="sun" style="width:18px;height:18px"></i>
          </div>

          <a class="avatar" href="/profile" title="Profile">
            <img
              src="<%= (typeof loggedInUser !== 'undefined' && loggedInUser.profileImg) ? loggedInUser.profileImg : (typeof currentUser !== 'undefined' && currentUser.profileImg) ? currentUser.profileImg : '/favicon.png' %>"
              alt="Profile"
            />
          </a>
          <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open menu">
           <i data-lucide="menu" style="width:20px;height:20px"></i>
          </button>
        </div>
      </div>
               <!-- Mobile Navigation Overlay -->
<div class="mobile-nav-overlay" id="mobileNavOverlay"></div>

<!-- Mobile Navigation Panel -->
<nav class="mobile-nav hidden" id="mobileNav">
  <div class="mobile-nav-header">
    <div class="mobile-nav-title">Menu</div>
    <button class="mobile-nav-close" id="mobileNavClose" aria-label="Close menu">
      <i data-lucide="x" style="width:18px;height:18px"></i>
    </button>
  </div>
  
  <div class="mobile-nav-links">
    <a href="/" class="active">
      <i data-lucide="home" style="width:18px;height:18px"></i>
      Home
    </a>
    <a href="/friends">
      <i data-lucide="users" style="width:18px;height:18px"></i>
      Friends
    </a>
    <a href="/mynotes">
      <i data-lucide="book-open" style="width:18px;height:18px"></i>
      My Notes
    </a>
    <a href="/logout">
      <i data-lucide="log-out" style="width:18px;height:18px"></i>
      Logout
    </a>
  </div>
  
  <div class="mobile-nav-divider"></div>
  
  <div class="mobile-nav-footer">
    <a href="/profile" class="btn-ghost" style="justify-content: center;">
      <i data-lucide="user" style="width:16px;height:16px"></i>
      View Profile
    </a>
  </div>
  </nav>
    </header>

    <main class="shell">
      <section class="page-header">
        <h1 class="page-title">Upload your notes</h1>
        <p class="page-subtitle">
          Add class/semester details and upload multiple images (pages).
        </p>
      </section>

      <!-- ✅ Logic unchanged: same form, same names, same compressor/fetch logic -->
      <form action="" method="post" enctype="multipart/form-data">
        <div class="card">
          <div class="card-head">
            <div class="head-left">
              <div class="chip" aria-hidden="true">
                <i data-lucide="file-up" style="width: 18px; height: 18px"></i>
              </div>
              <div style="min-width:0;">
                <div class="card-title">Upload Your Notes</div>
                <div class="card-hint">
                  Images will be compressed before uploading.
                </div>
              </div>
            </div>
          </div>

          <div class="card-body">
            <div class="field">
              <label class="label">Class and Sem name</label>
              <input
                type="text"
                name="classname"
                class="input"
                placeholder="eg: BCA 2nd"
              />
            </div>

            <div class="field">
              <label class="label">Notes Info</label>
              <input
                type="text"
                name="notesInfo"
                class="input"
                placeholder="eg: DBMS unit-1"
              />
            </div>

            <div class="field">
              <label class="label">Notes images</label>
              <div class="dropzone">
                <div class="chip" aria-hidden="true" style="width:52px;height:52px;border-radius:18px;">
                  <i data-lucide="image" style="width:22px;height:22px"></i>
                </div>
                <div style="font-weight:650;">Drag & drop your files here</div>
                <div style="font-size:0.82rem;color:var(--text-muted);">
                  or click to upload (multiple allowed)
                </div>

                <input
                  name="notesImages"
                  class="file-input"
                  type="file"
                  multiple
                />
              </div>
            </div>
          </div>

          <div class="card-actions">
            <button type="submit" class="btn-upload">Upload</button>
          </div>
        </div>
      </form>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/compressorjs@1.2.1/dist/compressor.min.js"></script>

    <script src="/JS/upload.js"></script>
  </body>
</html>