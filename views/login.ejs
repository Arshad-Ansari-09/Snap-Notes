<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="/CSS/login.css">
    <link rel="icon" type="image/x-icon" href="/favicon.png" />
    <title>Snap Notes — Login</title>
    <meta
      name="description"
      content="Snap Notes — Login to your account to upload, share, and download handwritten notes."
    />

    <!-- Poppins (same as home) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Lucide icons (same as home) -->
    <script src="https://unpkg.com/lucide@latest"></script>

  </head>

  <body>
    <header class="navbar">
      <div class="navbar-inner">
        <div class="brand">
          <div class="brand-logo">S</div>
          <div>
            <div class="brand-title">Snap Notes</div>
            <div class="brand-subtitle">Smart notes library</div>
          </div>
        </div>

        <div class="nav-right">
          <div class="theme-toggle" id="themeToggle" title="Toggle theme">
            <i data-lucide="sun" style="width: 18px; height: 18px"></i>
          </div>
        </div>
      </div>
    </header>

    <main class="shell">
      <section class="auth-wrap">
        <div class="auth-card">
          <div class="auth-head">
            <div class="auth-title">
              <h1>Login to your account</h1>
              <p>Get started with Snap Notes — just login and continue.</p>
            </div>
            <div class="auth-badge" aria-hidden="true">
              <i data-lucide="log-in" style="width: 18px; height: 18px"></i>
            </div>
          </div>

          <!-- ✅ Logic unchanged: same form, same names, same ids -->
          <form action="" method="post">
            <div class="auth-body">
              <div class="field">
                <label class="label" for="emailInput">Email</label>
                <input
                  id="emailInput"
                  type="email"
                  required
                  name="email"
                  placeholder="Email"
                  class="input"
                />
              </div>

              <div class="field pass-wrap">
                <label class="label" for="passInput">Password</label>

                <svg
                  id="passVisibler"
                  class="hidden"
                  xmlns="http://www.w3.org/2000/svg"
                  height="24px"
                  viewBox="0 -960 960 960"
                  width="24px"
                  fill="#9ca3af"
                >
                  <path
                    d="M480-320q75 0 127.5-52.5T660-500q0-75-52.5-127.5T480-680q-75 0-127.5 52.5T300-500q0 75 52.5 127.5T480-320Zm0-72q-45 0-76.5-31.5T372-500q0-45 31.5-76.5T480-608q45 0 76.5 31.5T588-500q0 45-31.5 76.5T480-392Zm0 192q-146 0-266-81.5T40-500q54-137 174-218.5T480-800q146 0 266 81.5T920-500q-54 137-174 218.5T480-200Zm0-300Zm0 220q113 0 207.5-59.5T832-500q-50-101-144.5-160.5T480-720q-113 0-207.5 59.5T128-500q50 101 144.5 160.5T480-280Z"
                  />
                </svg>

                <svg
                  id="passUnVisibler"
                  xmlns="http://www.w3.org/2000/svg"
                  height="26px"
                  viewBox="0 -960 960 960"
                  width="26px"
                  fill="#9ca3af"
                >
                  <path
                    d="m644-428-58-58q9-47-27-88t-93-32l-58-58q17-8 34.5-12t37.5-4q75 0 127.5 52.5T660-500q0 20-4 37.5T644-428Zm128 126-58-56q38-29 67.5-63.5T832-500q-50-101-143.5-160.5T480-720q-29 0-57 4t-55 12l-62-62q41-17 84-25.5t90-8.5q151 0 269 83.5T920-500q-23 59-60.5 109.5T772-302Zm20 246L624-222q-35 11-70.5 16.5T480-200q-151 0-269-83.5T40-500q21-53 53-98.5t73-81.5L56-792l56-56 736 736-56 56ZM222-624q-29 26-53 57t-41 67q50 101 143.5 160.5T480-280q20 0 39-2.5t39-5.5l-36-38q-11 3-21 4.5t-21 1.5q-75 0-127.5-52.5T300-500q0-11 1.5-21t4.5-21l-84-82Zm319 93Zm-151 75Z"
                  />
                </svg>

                <input
                  id="passInput"
                  placeholder="••••••••"
                  required
                  class="input"
                  type="password"
                  name="password"
                />
              </div>
            </div>

            <div class="auth-actions">
              <button class="btn-primary" type="submit">Login</button>

              <div class="auth-foot">
                Don’t have an account?
                <a href="/signup">Signup</a>
              </div>
            </div>
          </form>
        </div>
      </section>
    </main>

    <script src="/JS/login.js"></script>
  </body>
</html>