<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Snap Notes - Home</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="/CSS/home.css">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <!-- Google Font -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- Lucide icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- jsPDF -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

  
</head>

<body>
  <header class="navbar">
    <div class="navbar-inner">
      <div class="brand">
        <div class="brand-logo">S</div>
        <div>
          <div class="brand-title">Snap Notes</div>
          <div class="brand-subtitle">Smart notes library</div>
        </div>
      </div>

      <nav class="nav-links">
        <a href="/" class="active">Home</a>
        <a href="/friends">Friends</a>
        <a href="/mynotes">My Notes</a>
        <a href="/logout">
          <i data-lucide="log-out" style="width:18px;height:18px"></i>
        </a>
      </nav>

      <div class="nav-right">
        <button id="upload-btn" class="btn btn-primary upload-btn">
          <i data-lucide="upload" style="width:14px;height:14px"></i>
          Upload
        </button>
        <div class="theme-toggle" id="themeToggle" title="Toggle theme">
          <i data-lucide="sun" style="width:18px;height:18px"></i>
        </div>
        <div class="avatar nav-links" title="Profile">
          <a class="avatar" href="/profile" title="Profile">
            <img
              src="<%= (typeof loggedInUser !== 'undefined' && loggedInUser.profileImg) ? loggedInUser.profileImg : (typeof currentUser !== 'undefined' && currentUser.profileImg) ? currentUser.profileImg : '/favicon.png' %>"
              alt="Profile"
            />
          </a>
        </div>

        <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open menu">
         <i data-lucide="menu" style="width:20px;height:20px"></i>
        </button>

      </div>
    </div>

    <!-- Mobile Navigation Overlay -->
<div class="mobile-nav-overlay" id="mobileNavOverlay"></div>

<!-- Mobile Navigation Panel -->
<nav class="mobile-nav hidden" id="mobileNav">
  <div class="mobile-nav-header">
    <div class="mobile-nav-title">Menu</div>
    <button class="mobile-nav-close" id="mobileNavClose" aria-label="Close menu">
      <i data-lucide="x" style="width:18px;height:18px"></i>
    </button>
  </div>
  
  <div class="mobile-nav-links">
    <a href="/" class="active">
      <i data-lucide="home" style="width:18px;height:18px"></i>
      Home
    </a>
    <a href="/friends">
      <i data-lucide="users" style="width:18px;height:18px"></i>
      Friends
    </a>
    <a href="/mynotes">
      <i data-lucide="book-open" style="width:18px;height:18px"></i>
      My Notes
    </a>
    <a href="/logout">
      <i data-lucide="log-out" style="width:18px;height:18px"></i>
      Logout
    </a>
  </div>
  
  <div class="mobile-nav-divider"></div>
  
  <div class="mobile-nav-footer">
    <a href="/profile" class="btn-ghost" style="justify-content: center;">
      <i data-lucide="user" style="width:16px;height:16px"></i>
      View Profile
    </a>
  </div>
  </nav>
  </header>

  <div class="shell">
    <section class="page-header">
      <h1 class="page-title">Explore shared notes</h1>
      <p class="page-subtitle">Browse by class, semester, or search by any keyword.</p>
    </section>

    <section class="toolbar">
      <div class="toolbar-left">
        <span class="label">Filter</span>

        <div class="select-wrap">
          <select id="class-filter" class="select">
            <option value="Class">Class</option>
            <option value="BCA">BCA</option>
            <option value="MCA">MCA</option>
            <option value="B.Com">B.Com</option>
            <option value="M.Com">M.Com</option>
            <option value="B.Tech">B.Tech</option>
            <option value="M.Tech">M.Tech</option>
            <option value="12th">12th</option>
            <option value="11th">11th</option>
            <option value="10th">10th</option>
            <option value="9th">9th</option>
          </select>
          <i data-lucide="chevron-down" style="width:13px;height:13px"></i>
        </div>

        <div class="select-wrap">
          <select id="sem-filter" class="select">
            <option value="Sem">Sem</option>
            <option value="1st">1st</option>
            <option value="2nd">2nd</option>
            <option value="3rd">3rd</option>
            <option value="4th">4th</option>
            <option value="5th">5th</option>
            <option value="6th">6th</option>
            <option value="7th">7th</option>
            <option value="8th">8th</option>
          </select>
          <i data-lucide="chevron-down" style="width:13px;height:13px"></i>
        </div>
      </div>

      <div class="toolbar-right">
        <div class="search">
          <input id="nameInput" type="text" placeholder="Search by name or notes info" autocomplete="off" />
        </div>
      </div>
    </section>

    <!-- IMPORTANT: Code 2 expects #Container > div -->

    
    <main id="Container" class="grid">
      <% if (notes && notes.length > 0) { %> 
      <% notes.forEach(note => { %>
        <div>
          <!-- Code 1 card styling -->
          <article class="note-card">
            <div class="note-thumb">
              <img
                class="preview-img"
                src="<%= note.notesImages[0] %>"
                alt="Note preview"
                data-images='<%= JSON.stringify(note.notesImages) %>'
                data-notesinfo="<%= note.notesInfo %>"
              >
              <div class="note-thumb-gradient"></div>

              <span class="badge-top">
                <i data-lucide="book-open" style="width:12px;height:12px"></i>
                <%= note.classname %>
              </span>

              <!-- Code 2 expects .download-pdf-btn and a sibling .download-menu -->
              <button
                class="download-btn download-pdf-btn"
                title="Download Options"
                data-images='<%= JSON.stringify(note.notesImages) %>'
                data-classname="<%= note.classname %>"
                data-info="<%= note.notesInfo %>"
              >
                <span class="btn-icon">
                  <i data-lucide="download" style="width:15px;height:15px"></i>
                </span>

                <span class="btn-spinner hidden">
                  <svg class="animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" width="18" height="18">
                    <circle opacity="0.25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path opacity="0.75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                  </svg>
                </span>

                <span class="btn-progress-text hidden" style="margin-left:6px;font-size:0.72rem;font-weight:600;"></span>
              </button>

              <div class="download-menu hidden">
                <button class="download-as-pdf">Download as PDF 📄</button>
                <button class="download-as-images">Download as Images 🖼️</button>
              </div>
            </div>

            <div class="note-body">
              <p class="note-title"><%= note.notesInfo %></p>

              <div class="tags">
                <span class="tag"><%= note.classname %></span>
                <span class="tag"><%= note.notesImages.length %> pages</span>
              </div>

              <div class="note-meta">
                <p class="author">
                  <i data-lucide="user" style="width:13px;height:13px"></i>
                  By <span><%= note.user.username %></span>
                </p>
              </div>

              <div class="note-footer">
                <% if (note.user._id.toString() === loggedInUser._id.toString()) { %>
                <a href="/myNotes" class="btn-ghost view-note-btn">
                  <i data-lucide="eye" style="width:13px;height:13px"></i>
                  My notes
                </a>
                <% } else { %>
                  <a href="/user/<%= note.user._id %>/allNotes" class="btn-ghost view-note-btn">
                  <i data-lucide="eye" style="width:13px;height:13px"></i>
                  View note
                  </a>
                  <% } %>

                <div class="note-meta-right">   
                  <span>
                    <% if (note.user._id.toString() !== loggedInUser._id.toString() && !loggedInUser.friends.map(id => id._id.toString()).includes(note.user._id.toString())) { %>
                      <a href="/addFriend/<%= note.user._id %>" class="btn-add-friend js-friend-btn bg-blue-700 text-white px-2 py-1 rounded mt-2 cursor-pointer hover:bg-blue-800">Add to Friend</a>
                    <% } else { %>
                     <span class="btn-friend-status" aria-disabled="true">
                       <i data-lucide="check-circle" class="text-green-500" style="width:15px;height:15px"></i>
                        Added
                      </span>
                    <% } %>
                  </span>
                </div>
              </div>
            </div>
          </article>

          <!-- Hidden text nodes needed by Code 2 filter logic (exact selectors) -->
          <div class="className hidden">Class name: <%= note.classname %></div>
          <div class="notesInfo hidden">Notes Info: <%= note.notesInfo %></div>
          <div class="userName hidden">By: <%= note.user.username %></div>
        </div>
      <% }) %>
      <% } else { %>
      <div class="panel">
        <div class="panel-body">
          <h1 style="text-align:center; font-size:1.8rem; padding:1rem 0;">
            No Notes yet.
          </h1>
        </div>
      </div>
      <% } %>
    </main>
  </div>

  <div id="upload-preview" class="hidden upload-overlay" aria-hidden="true">
  <div class="upload-panel">
    <div class="upload-head">
      <div class="upload-title">Upload Your Notes</div>
      <button type="button" id="upload-close" class="upload-close">✕</button>
    </div>
    <hr>
    <form action="/upload/notes" method="post" enctype="multipart/form-data" class="px-4">
  <div class="max-w-xl mx-auto rounded-md overflow-hidden">
    <!-- Inputs -->
    <div class="flex flex-col gap-3 mt-4 space-y-4 px-2">
      <div>
        <label class="block font-medium">Class and Sem name / Title</label>
        <input 
          required
          type="text" 
          name="classname" 
          class="h-10 w-full bg-stone-200 mb-1 border border-black px-3 block" 
          placeholder="eg: BCA 2nd / Docker">
      </div>

      <div>
        <label class="block font-medium">Notes Info / Description</label>
        <input 
          required
          type="text" 
          name="notesInfo" 
          class="h-10 w-full bg-stone-200 mb-1 border border-black px-3 block" 
          placeholder="eg: DBMS unit-1 / Docker Cheet Sheet">
      </div>
    </div>

    <!-- File Upload -->
    <div class="w-full p-3 mx-2">
      <div
        class="relative h-40 md:h-48 rounded-lg border-2 border-blue-500 bg-gray-100 flex justify-center items-center shadow-lg hover:shadow-xl transition-shadow duration-300 ease-in-out"
      >
        <div class="absolute flex flex-col items-center text-center px-2">
          <img
            alt="File Icon"
            class="mb-2 w-12 h-12 md:w-16 md:h-16"
            src="https://img.icons8.com/dusk/64/000000/file.png"
          />
          <span class="block text-gray-500 font-semibold text-sm md:text-base">
            Drag &amp; drop your files here
          </span>
          <span class="block text-gray-400 font-normal text-xs md:text-sm mt-1">
            or click to upload
          </span>
        </div>

        <input
          name="notesImages"
          class="h-full w-full opacity-0 cursor-pointer"
          accept="image/*,.pdf"
          type="file"
          multiple
          required
        />
      </div>
    </div>

    <!-- Submit Button -->
    <div class="flex flex-col gap-2 justify-center items-center mt-4 mb-6">
      <button
        type="submit"
        class="bg-blue-600 px-6 py-2 rounded-md hover:bg-blue-700 text-white cursor-pointer w-full sm:w-auto"
      >
        Upload
      </button>
      <p
        id="uploadStatus"
        class="hidden mt-3 text-sm text-center text-gray-200"
      ></p>
    </div>
  </div>
</form>
  </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/compressorjs@1.2.1/dist/compressor.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script>
     pdfjsLib.GlobalWorkerOptions.workerSrc =
      "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
  </script>
  <script src="/JS/home.js"></script>
</body>
</html>