<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Snap Notes – Friends</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="/CSS/friends.css">

    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- jsPDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <link rel="icon" type="image/x-icon" href="/favicon.png" />

  </head>

  <body>
    <header class="navbar">
      <div class="navbar-inner">
        <div class="brand">
          <div class="brand-logo">S</div>
          <div>
            <div class="brand-title">Snap Notes</div>
            <div class="brand-subtitle">Smart notes library</div>
          </div>
        </div>

        <nav class="nav-links">
          <a href="/">Home</a>
          <a href="/friends" class="active">Friends</a>
          <a href="/mynotes">My Notes</a>
          <a href="/logout">
            <i data-lucide="log-out" style="width:18px;height:18px"></i>
          </a>
        </nav>

        <div class="nav-right">
          <div class="theme-toggle" id="themeToggle" title="Toggle theme">
            <i data-lucide="sun" style="width: 18px; height: 18px"></i>
          </div>

          <a class="avatar" href="/profile" title="Profile">
            <img
              src="<%= (typeof loggedInUser !== 'undefined' && loggedInUser.profileImg) ? loggedInUser.profileImg : (typeof currentUser !== 'undefined' && currentUser.profileImg) ? currentUser.profileImg : 'https://res.cloudinary.com/da3xuvuus/image/upload/v1755686150/default_ldpsps.jpg' %>"
              alt="Profile"
            />
          </a>
          <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open menu">
            <i data-lucide="menu" style="width:20px;height:20px"></i>
          </button>
        </div>
      </div>
      <!-- Mobile Navigation Overlay -->
<div class="mobile-nav-overlay" id="mobileNavOverlay"></div>

<!-- Mobile Navigation Panel -->
<nav class="mobile-nav hidden" id="mobileNav">
  <div class="mobile-nav-header">
    <div class="mobile-nav-title">Menu</div>
    <button class="mobile-nav-close" id="mobileNavClose" aria-label="Close menu">
      <i data-lucide="x" style="width:18px;height:18px"></i>
    </button>
  </div>
  
  <div class="mobile-nav-links">
    <a href="/">
      <i data-lucide="home" style="width:18px;height:18px"></i>
      Home
    </a>
    <a href="/friends" class="active">
      <i data-lucide="users" style="width:18px;height:18px"></i>
      Friends
    </a>
    <a href="/mynotes">
      <i data-lucide="book-open" style="width:18px;height:18px"></i>
      My Notes
    </a>
    <a href="/logout">
      <i data-lucide="log-out" style="width:18px;height:18px"></i>
      Logout
    </a>
  </div>
  
  <div class="mobile-nav-divider"></div>
  
  <div class="mobile-nav-footer">
    <a href="/profile" class="btn-ghost" style="justify-content: center;">
      <i data-lucide="user" style="width:16px;height:16px"></i>
      View Profile
    </a>
  </div>
  </nav>
    </header>

    <div class="shell">
      <section class="page-header">
        <h1 class="page-title">Friends</h1>
        <p class="page-subtitle">Open a friend to browse their notes.</p>
      </section>

      <% if (friends.length>0) { %>
      <section class="friends-layout">
        <!-- LEFT -->
        <aside id="friendsPanel" class="panel">
          <div class="panel-head">
            <div class="panel-title">
              <i data-lucide="users" style="width:18px;height:18px"></i>
              Your friends
            </div>
            <div style="color:var(--text-muted); font-size:0.78rem;">
              <%= friends.length %> total
            </div>
          </div>

          <div class="panel-body">
            <% friends.reverse().forEach(friend => { %>
            <div class="friend-row">
              <a
                href="/friend/<%= friend._id %>/notes"
                class="friend-link"
                onclick="showNotes(event)"
              >
                <div
                  class="friend-item <%= user && user._id.toString() === friend._id.toString() ? 'friend-active' : '' %>"
                >
                  <div class="friend-avatar">
                    <img src="<%= friend.profileImg %>" alt="Profile" />
                  </div>
                  <div class="friend-name"><%= friend.username %></div>
                </div>
              </a>

              <a class="icon-btn" href="/delete/friend/<%= friend._id %>" title="Remove friend">
                <i data-lucide="trash-2" style="width:18px;height:18px"></i>
              </a>
            </div>
            <% }) %>
          </div>
        </aside>

        <!-- RIGHT -->
        <main id="notesContainer" class="panel <%= user ? '' : 'hidden' %>">
          <div class="panel-head">
            <div class="panel-title">
              <i data-lucide="notebook" style="width:18px;height:18px"></i>
              <% if (user) { %><%= user.username %>'s notes<% } else { %>Notes<% } %>
            </div>

            <button onclick="goBackToFriends()" class="mobile-back">
              <i data-lucide="arrow-left" style="width:16px;height:16px"></i>
              Back
            </button>
          </div>

          <div class="panel-body">
            <% if (user) { %>
            <section class="toolbar">
              <div class="toolbar-left">
                <span class="label">Filter</span>

                <div class="select-wrap">
                  <select id="class-filter" class="select">
                    <option value="Class">Class</option>
                    <option value="BCA">BCA</option>
                    <option value="MCA">MCA</option>
                    <option value="B.Com">B.Com</option>
                    <option value="M.Com">M.Com</option>
                    <option value="B.Tech">B.Tech</option>
                    <option value="M.Tech">M.Tech</option>
                    <option value="12th">12th</option>
                    <option value="11th">11th</option>
                    <option value="10th">10th</option>
                    <option value="9th">9th</option>
                  </select>
                  <i data-lucide="chevron-down" style="width:13px;height:13px"></i>
                </div>

                <div class="select-wrap">
                  <select id="sem-filter" class="select">
                    <option value="Sem">Sem</option>
                    <option value="1st">1st</option>
                    <option value="2nd">2nd</option>
                    <option value="3rd">3rd</option>
                    <option value="4th">4th</option>
                    <option value="5th">5th</option>
                    <option value="6th">6th</option>
                    <option value="7th">7th</option>
                    <option value="8th">8th</option>
                  </select>
                  <i data-lucide="chevron-down" style="width:13px;height:13px"></i>
                </div>
              </div>

              <div class="toolbar-right">
                <div class="search">
                  <input id="nameInput" type="text" placeholder="Search by notes info" autocomplete="off" />
                </div>
              </div>
            </section>

            <section class="grid">
              <% user.posts.reverse().forEach(post => { %>
              <article class="note-card">
                <div class="note-thumb">
                  <img
                    class="preview-img"
                    src="<%= post.notesImages[0] %>"
                    alt="Note preview"
                    data-images="<%= JSON.stringify(post.notesImages) %>"
                    data-notesinfo="<%= post.notesInfo %>"
                  />
                  <div class="note-thumb-gradient"></div>

                  <span class="badge-top">
                    <i data-lucide="book-open" style="width:12px;height:12px"></i>
                    <%= post.classname %>
                  </span>

                  <!-- ✅ Home-like button + progress + menu -->
                  <button
                    class="download-btn download-pdf-btn"
                    title="Download Options"
                    data-images="<%= JSON.stringify(post.notesImages) %>"
                    data-classname="<%= post.classname %>"
                    data-info="<%= post.notesInfo %>"
                  >
                    <span class="btn-icon">
                      <i data-lucide="download" style="width:15px;height:15px"></i>
                    </span>

                    <span class="btn-spinner hidden">
                      <svg class="animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" width="18" height="18">
                        <circle opacity="0.25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path opacity="0.75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                      </svg>
                    </span>

                    <span class="btn-progress-text hidden" style="margin-left:6px;font-size:0.72rem;font-weight:600;"></span>
                  </button>

                  <div class="download-menu hidden">
                    <button class="download-as-pdf">Download as PDF 📄</button>
                    <button class="download-as-images">Download as Images 🖼️</button>
                  </div>
                </div>

                <div class="note-body">
                  <div class="note-title"><%= post.notesInfo %></div>

                  <div class="tags">
                    <span class="tag"><%= post.classname %></span>
                    <span class="tag"><%= post.notesImages.length %> pages</span>
                  </div>

                  <!-- needed by filter -->
                  <div class="className hidden">Class name: <%= post.classname %></div>
                  <div class="notesInfo hidden">Notes Info: <%= post.notesInfo %></div>
                </div>
              </article>
              <% }) %>
            </section>
            <% } else { %>
            <h1 style="text-align:center; font-size:1.6rem; padding:1.2rem 0;">
              Nothing to see here.
            </h1>
            <% } %>
          </div>
        </main>
      </section>
      <% } else { %>
      <div class="panel" style="height:auto;">
        <div class="panel-body">
          <h1 style="text-align:center; font-size:1.8rem; padding:1rem 0;">
            No friends yet.
          </h1>
        </div>
      </div>
      <% } %>
    </div>

    <script src="/JS/friends.js"></script>
  </body>
</html>