<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="icon" type="image/x-icon" href="/favicon.png" />
    <link rel="stylesheet" href="/CSS/changeProfileImg.css">
    <title>Snap Notes — Change Profile Image</title>
    <meta
      name="description"
      content="Snap Notes — Change your profile image."
    />

    <!-- Poppins + Lucide (home-like) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://unpkg.com/lucide@latest"></script>
    
  </head>

  <body>
    <!-- ✅ Home-like navbar with links -->
    <header class="navbar">
      <div class="navbar-inner">
        <div class="brand">
          <div class="brand-logo">S</div>
          <div>
            <div class="brand-title">Snap Notes</div>
            <div class="brand-subtitle">Smart notes library</div>
          </div>
        </div>

        <nav class="nav-links">
          <a href="/">Home</a>
          <a href="/friends">Friends</a>
          <a href="/mynotes">My Notes</a>
          <a href="/logout">
            <i data-lucide="log-out" style="width:18px;height:18px"></i>
          </a>
        </nav>

        <div class="nav-right">
          <div class="theme-toggle" id="themeToggle" title="Toggle theme">
            <i data-lucide="sun" style="width: 18px; height: 18px"></i>
          </div>
          <a class="avatar" href="/profile" title="Profile">SN</a>
          <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open menu">
         <i data-lucide="menu" style="width:20px;height:20px"></i>
        </button>
        </div>
      </div>
          <!-- Mobile Navigation Overlay -->
<div class="mobile-nav-overlay" id="mobileNavOverlay"></div>

<!-- Mobile Navigation Panel -->
<nav class="mobile-nav hidden" id="mobileNav">
  <div class="mobile-nav-header">
    <div class="mobile-nav-title">Menu</div>
    <button class="mobile-nav-close" id="mobileNavClose" aria-label="Close menu">
      <i data-lucide="x" style="width:18px;height:18px"></i>
    </button>
  </div>
  
  <div class="mobile-nav-links">
    <a href="/" class="active">
      <i data-lucide="home" style="width:18px;height:18px"></i>
      Home
    </a>
    <a href="/friends">
      <i data-lucide="users" style="width:18px;height:18px"></i>
      Friends
    </a>
    <a href="/mynotes">
      <i data-lucide="book-open" style="width:18px;height:18px"></i>
      My Notes
    </a>
    <a href="/logout">
      <i data-lucide="log-out" style="width:18px;height:18px"></i>
      Logout
    </a>
  </div>
  
  <div class="mobile-nav-divider"></div>
  
  <div class="mobile-nav-footer">
    <a href="/profile" class="btn-ghost" style="justify-content: center;">
      <i data-lucide="user" style="width:16px;height:16px"></i>
      View Profile
    </a>
  </div>
  </nav>
    </header>

    <main class="shell">
      <section class="page-header">
        <h1 class="page-title">Change profile image</h1>
        <p class="page-subtitle">Upload a new profile photo.</p>
      </section>

      <!-- ✅ LOGIC UNCHANGED: same form action/method/enctype, same input name, required, multiple -->
      <form action="" method="post" enctype="multipart/form-data">
        <div class="card">
          <div class="card-head">
            <div class="head-left">
              <div class="chip" aria-hidden="true">
                <i data-lucide="camera" style="width: 18px; height: 18px"></i>
              </div>
              <div>
                <div class="card-title">Upload new photo</div>
                <div class="card-hint">PNG/JPG recommended.</div>
              </div>
            </div>
          </div>

          <div class="card-body">
            <div class="dropzone">
              <div>
                <div class="dropzone-icon" aria-hidden="true">
                  <i data-lucide="image-plus" style="width: 22px; height: 22px"></i>
                </div>
                <div class="dz-title">Drag & drop your image here</div>
                <div class="dz-sub">or click to upload</div>
              </div>

              <input
                name="profileImg"
                class="file-input"
                required
                type="file"
                multiple
              />
            </div>
          </div>

          <div class="card-actions">
            <button type="submit" class="btn-primary">Change</button>
          </div>
        </div>
      </form>
    </main>

    <script src="/JS/changeProfileImg.js"></script>
  </body>
</html>